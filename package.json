{
  "name": "dsh-chat-export",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "会话导出书签码：自动滚动加载全对话→下载txt+媒体附件清单 Bookmarklet generator: auto-scroll full chat export to txt with media inventory.",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "workflow"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@antinomyhq/forge": "*"
  }
}
